app/dist/
# Tauri's generated files: gen/schemas is rewritten by every build; gen/android is the Android
# project, versioned (its own .gitignore files keep its build outputs, the copied .so files and
# anything machine-specific out).
app/src-tauri/gen/*
!app/src-tauri/gen/android/
cores/*
!cores/README.md
!cores/SOURCES.md
*.sav
*.state
.DS_Store
# Local secrets (licence rule 6): .env files are never versioned; OAuth secrets live in user
# environment variables (EMUDOME_GOOGLE_CLIENT_SECRET), read at build time.
.env
.env.*
# Images and files other sessions (Cowork) drop in the project folder: never versioned.
/Claude outputs/
