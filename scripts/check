#!/bin/sh
# Every check in the project, in a single command: `sh scripts/check` (Git Bash, Linux),
# `./scripts/check.ps1` (PowerShell), or `pnpm check` / `npm run check` from app/.
#
# There's no CI: this is the list, and it lives here and nowhere else. The README, the
# pre-commit hook and CLAUDE.md point to this file instead of repeating the commands, so
# they can't drift apart. Run it before wrapping up a piece of work.
#
# It doesn't stop at the first failure: it runs everything and summarizes at the end.
# Knowing that three different things failed changes what you do next; finding them out
# one at a time doesn't. Exit 1 with a FAILED list, or "all green". It never rewrites a file.
#
# Frontend steps run in app/ through its package.json scripts, and only when the script exists
# (they say "skipped" otherwise). The package manager is pnpm when app/pnpm-lock.yaml exists,
# npm before the switch.
#
# The gates at the end are greps over the files git sees (tracked, plus untracked files that
# are not ignored): target/, node_modules/, dist/ and cores/ are never read.
#
# `--fast`: the quick pass while working on a branch. The same list, except two steps, each said
# "skipped" with the reason so the summary never reads all green:
# - the Android clippy steps (one more full compilation each);
# - `cargo test` runs only the workspace packages changed since the branch left develop (committed,
#   staged, unstaged or untracked), or all of them when a shared manifest changed. It cannot see a
#   test of another package broken at run time by the change (clippy --all-targets still compiles
#   every test).
# The full check, without --fast, is what the merge rule asks for (CLAUDE.md).

set -u
cd "$(dirname "$0")/.." || exit 1

fast=0
case "${1:-}" in
--fast) fast=1 ;;
'') ;;
*)
	printf 'usage: scripts/check [--fast]\n'
	exit 2
	;;
esac

if [ -f app/pnpm-lock.yaml ]; then pm=pnpm; else pm=npm; fi

failed=''
skipped=''
run() {
	name=$1
	shift
	printf '\n=== %s\n' "$name"
	if "$@"; then
		return 0
	fi
	failed="$failed [$name]"
	return 1
}

# A step that could not run here: said under its name and again in the summary, never silently green.
skip() {
	printf '\n=== %s\nskipped: %s\n' "$1" "$2"
	skipped="$skipped [$1]"
}

# --- Node first: on a Node outside engines.node (app/package.json) every frontend step would fail
# later without saying why, so the check stops here. The script's self-test runs its range parser
# on known versions first.
printf '\n=== node version\n'
if ! node scripts/node-version.mjs --self-test; then
	printf '\nFAILED: [node version]\n'
	exit 1
fi

# Whether app/package.json declares the package script $1.
has_script() {
	node -e 'process.exit(require("./app/package.json").scripts?.[process.argv[1]] ? 0 : 1)' "$1"
}

in_app() {
	(cd app && "$@")
}

run_script() {
	if has_script "$1"; then
		run "$pm run $1" in_app "$pm" run "$1"
	else
		skip "$pm run $1" "no $1 script in app/package.json"
	fi
}

# A gate that fails when the command FINDS something. git grep / grep: exit 0 = found (fail,
# the matches are already printed), 1 = nothing found (pass), anything else = error (fail).
forbid() {
	name=$1
	why=$2
	shift 2
	printf '\n=== %s\n' "$name"
	"$@"
	rc=$?
	if [ "$rc" -eq 1 ]; then
		printf 'none\n'
		return 0
	fi
	[ "$rc" -eq 0 ] && printf '%s\n' "$why"
	failed="$failed [$name]"
	return 1
}

# Files that must never be in the repository: ROMs and Nintendo BIOS / firmware / keys, by
# name. The homebrew test ROMs (GBA, NDS) are the allowed exceptions. Cannot see a file renamed to
# another extension, or one kept in a git-ignored folder (cores/, *.sav: never committed).
nintendo_files() {
	git ls-files --cached --others --exclude-standard |
		grep -iE '\.(gb|gbc|gba|nds|dsi|srl|3ds|3dsx|cia|cci|cxi|cxa|z3ds)$|(^|/)(gba_bios|bios7|bios9|dsi_bios7|dsi_bios9|firmware|dsi_firmware|dsi_nand|boot9|boot11|aes_keys|seeddb|movable|secinfo|otp)\.(bin|txt|sed|dat)$' |
		grep -vxF -e 'tools/test-rom/emudome-test.gba' -e 'tools/test-rom-nds/emudome-test.nds'
}

# Licence rule 6, no secrets in the repo: signing keystores, by extension (tracked, or untracked and
# not ignored). Android release signing reads its keystore from outside the repository
# (EMUDOME_KEYSTORE, app/src-tauri/gen/android/app/build.gradle.kts). Cannot see a keystore under
# another name, or a password written into a file.
keystore_files() {
	git ls-files --cached --others --exclude-standard | grep -iE '\.(jks|keystore|p12|pfx)$'
}

# --- Rust
run 'cargo fmt' cargo fmt --all --check
run 'cargo clippy' cargo clippy --workspace --all-targets -- -D warnings

# For --fast: the `-p <package>` arguments of the workspace packages changed since the merge base
# with develop, `--workspace` when a shared manifest changed (or there is no develop to compare
# with), nothing when no Rust package changed.
changed_packages() {
	base=$(git merge-base HEAD develop 2>/dev/null) || {
		printf -- '--workspace\n'
		return
	}
	found=$({
		git diff --name-only "$base"
		git ls-files --others --exclude-standard
	} | sed -n -E \
		-e 's#^(Cargo\.toml|Cargo\.lock|clippy\.toml|\.cargo/.*)$#--workspace#p' \
		-e 's#^crates/(libretro-sys|emudome-core|emudome-platform)/.*#-p \1#p' \
		-e 's#^app/src-tauri/.*#-p emudome#p' |
		sort -u)
	if printf '%s\n' "$found" | grep -qx -- '--workspace'; then
		printf -- '--workspace\n'
	else
		printf '%s\n' "$found" | grep -v '^$'
	fi
}

if [ "$fast" -eq 1 ]; then
	packages=$(changed_packages | tr '\n' ' ')
	if [ -z "$packages" ]; then
		skip 'cargo test' '--fast: no Rust package changed since develop'
	else
		# shellcheck disable=SC2086 # one argument per word
		run "cargo test $packages" cargo test $packages
		case "$packages" in
		--workspace*) ;;
		*) skipped="$skipped [cargo test: the packages not changed (--fast)]" ;;
		esac
	fi
else
	run 'cargo test' cargo test --workspace
fi

# --- The other targets (CLAUDE.md, engineering rule 8: green on Windows is not green).
# Android: clippy for aarch64-linux-android, in two parts. The crates with no C code for the target
# (libretro-sys, emudome-core, emudome-platform: where the Android code lives) need only the Rust
# target. The whole workspace also needs the Android NDK: the app's dependencies build C / C++ for
# Android (glslang-sys, under librashader); its clang goes on PATH for that command only. A machine
# without them says "skipped" with the reason. Cannot see what only links or runs on a device
# (cargo check does not link), nor the Kotlin side (Gradle).
android_target=aarch64-linux-android

# The NDK folder: ANDROID_NDK_HOME, NDK_HOME or ANDROID_NDK_ROOT, else the newest one in
# <sdk>/ndk/, the SDK being ANDROID_HOME, ANDROID_SDK_ROOT or where Android Studio puts it by
# default (%LOCALAPPDATA%\Android\Sdk on Windows, ~/Android/Sdk on Linux). Prints nothing when
# there is none.
android_ndk() {
	for dir in "${ANDROID_NDK_HOME:-}" "${NDK_HOME:-}" "${ANDROID_NDK_ROOT:-}"; do
		if [ -n "$dir" ] && [ -d "$dir/toolchains/llvm/prebuilt" ]; then
			printf '%s\n' "$dir"
			return
		fi
	done
	for sdk in "${ANDROID_HOME:-}" "${ANDROID_SDK_ROOT:-}" \
		"${LOCALAPPDATA:+$LOCALAPPDATA/Android/Sdk}" "${HOME:+$HOME/Android/Sdk}"; do
		if [ -n "$sdk" ] && [ -d "$sdk/ndk" ]; then
			newest=$(ls -d "$sdk"/ndk/*/toolchains/llvm/prebuilt 2>/dev/null | sort -V | tail -n 1)
			if [ -n "$newest" ]; then
				printf '%s\n' "${newest%/toolchains/llvm/prebuilt}"
				return
			fi
		fi
	done
}

android_workspace() {
	bin=$(ls -d "$1"/toolchains/llvm/prebuilt/*/bin 2>/dev/null | head -n 1)
	if [ -z "$bin" ]; then
		printf 'no toolchains/llvm/prebuilt/<host>/bin in the NDK folder\n'
		return 1
	fi
	# cc-rs finds clang / clang++ on PATH and passes --target itself.
	PATH="$bin:$PATH" AR_aarch64_linux_android="$bin/llvm-ar" \
		cargo clippy --workspace --target "$android_target" -- -D warnings
}

if [ "$fast" -eq 1 ]; then
	skip 'cargo clippy: android' '--fast: run the full check before merging'
elif rustup target list --installed 2>/dev/null | grep -qx "$android_target"; then
	run 'cargo clippy: android, crates without C code' \
		cargo clippy --target "$android_target" -p libretro-sys -p emudome-core -p emudome-platform -- -D warnings
	ndk=$(android_ndk)
	if [ -n "$ndk" ]; then
		run 'cargo clippy: android, workspace' android_workspace "$ndk"
	else
		skip 'cargo clippy: android, workspace' 'no Android NDK (set ANDROID_NDK_HOME or NDK_HOME, or install it under <Android SDK>/ndk/): the app builds C++ for Android (glslang-sys)'
	fi
else
	skip 'cargo clippy: android' "the Rust target is not installed: rustup target add $android_target"
fi

# The other desktop: the Rust steps above compile for this machine's OS only. Linux needs its own
# system libraries (WebKitGTK, GTK through pkg-config), Windows its own SDK, so neither is
# cross-checked: the other one is said skipped. Run this script there (Linux: a PC or WSL).
case "$(rustc -vV 2>/dev/null | sed -n 's/^host: //p')" in
*windows*) skip 'other desktop: linux' 'needs a Linux system (WebKitGTK, GTK): run sh scripts/check on Linux or WSL' ;;
*linux*) skip 'other desktop: windows' 'needs Windows (MSVC, Windows SDK): run ./scripts/check.ps1 on Windows' ;;
*) skip 'other desktop' 'unknown host: no other desktop is checked' ;;
esac

# --- Licences (CLAUDE.md, licence rule 2): every crate and npm package must carry a licence
# compatible with GPL-3.0-or-later. The allow-lists, the proof that each check fails, and their
# blind spots are in deny.toml and scripts/npm-licenses.mjs. Neither sees the libretro cores,
# fonts, icons or the test ROM: those are reviewed by hand in THIRD_PARTY.md.
cargo_deny() {
	if ! cargo deny --version >/dev/null 2>&1; then
		printf 'cargo-deny is not installed. Install it with: cargo install cargo-deny --locked\n'
		return 1
	fi
	cargo deny --log-level error check licenses
}
run 'licences: crates' cargo_deny
if [ "$pm" = pnpm ]; then
	run 'licences: npm' node scripts/npm-licenses.mjs
else
	skip 'licences: npm' 'needs pnpm (app/pnpm-lock.yaml)'
fi

# THIRD_PARTY.md's generated tables (every crate and npm package with its licence) are regenerated in
# memory and compared with the committed ones (Trello #83); the fix is printed
# (`node scripts/third-party-tables.mjs --write`). Blind spots, in the script: a stale app/node_modules,
# the spike's own workspace, the hand-written sections above the tables.
if [ "$pm" = pnpm ]; then
	run 'third-party tables' node scripts/third-party-tables.mjs --check
else
	skip 'third-party tables' 'needs pnpm (app/pnpm-lock.yaml)'
fi

# --- The libretro cores (CLAUDE.md, engineering rule 3): cores.lock, the bundle lists generated
# from it (app/src-tauri/package/), cores/SOURCES.md, the Gradle build and THIRD_PARTY.md agree,
# tauri.conf.json lists no resource of its own, and the versioned Android project
# (app/src-tauri/gen/android) is there and adds no jniLibs folder of its own (Trello #76).
# --self-test feeds every rule a broken input first. Offline: it cannot see whether a URL still
# serves the pinned bytes (only a fetch can).
run 'cores: lock, bundle lists, sources, android project, docs' node scripts/cores.mjs check --self-test

# --- One version (Trello #83): [workspace.package] version in Cargo.toml, copied into app/package.json and
# tauri.conf.json (the Tauri CLI takes Android's versionName only from there), every member inheriting it.
# --self-test feeds it broken inputs first. What it cannot see is in the script.
run 'version in one place' node scripts/versions.mjs --self-test

# --- The update manifest (Trello #44): the release build's key check (no key file inside the
# repository) and latest.json's shape (version, signature, download address). --self-test only:
# the real keys exist only in the owner's release environment. What it cannot see is in the script.
run 'update manifest and release keys' node scripts/updater-manifest.mjs --self-test

# --- Frontend (app/)
run_script typecheck
run_script test
run_script lint
run_script format:check

# --- Gates (CLAUDE.md rules made into checks)

# No merge conflict marker left in a text file: Markdown, CSS and many text files parse fine
# with them. A line of seven `=` alone is not flagged (valid Markdown underline).
forbid 'conflict markers' 'Finish resolving the merge.' \
	git grep --untracked -nIE '^(<{7} |>{7} |\|{7}( |$))'

# "No #[cfg(target_os)] outside crates/emudome-platform": every OS-specific line lives there,
# and so does every form-factor branch (engineering rule 8: Tauri's cfg(desktop) / cfg(mobile)
# and Cargo.toml target tables are OS branching too). Three greps, one gate:
# - cfg(...) / cfg!(...) / cfg_attr(...) naming target_os, target_family, windows or unix on one
#   line, in every .rs file outside the crate (no exception);
# - the same naming desktop or mobile, except in the files of OS_CFG_EXCEPTIONS;
# - a `[target.<triple or cfg>]` table in a Cargo.toml outside the crate, except the lines of
#   OS_TARGET_TABLE_EXCEPTIONS (matched whole: a new table in the same file still fails).
# Cannot see a cfg split across lines, OS code chosen at runtime (env::consts::OS), or a target
# table written as dotted keys (`target.'cfg(..)'.dependencies.x = ..`). A cfg naming a feature
# or a string with `desktop` / `mobile` in it on one line is flagged too: rename it.
#
# The exceptions are temporary, each with its reason; the lists only shrink.
# - app/src-tauri/src/{lib,library,saves}.rs: moved in #72 phase 2, after #70 (that card is
#   rewriting these files): the gamepad module and send_command (SDL3 is desktop-only), the mobile
#   entry point, the folder / image / save-file pickers (they go next to emudome_platform::pick_file).
OS_CFG_EXCEPTIONS='app/src-tauri/src/lib.rs app/src-tauri/src/library.rs app/src-tauri/src/saves.rs'
# - app/src-tauri/Cargo.toml, sdl3-sys only off Android / iOS: gamepad.rs (SDL3) moves behind
#   emudome-platform in #72 phase 2, with its `mod gamepad` cfg in lib.rs (#70).
OS_TARGET_TABLE_EXCEPTIONS="app/src-tauri/Cargo.toml:[target.'cfg(not(any(target_os = \"android\", target_os = \"ios\")))'.dependencies]"

# Exit status like git grep: 0 = found something (printed), 1 = nothing, other = error.
os_code() {
	git grep --untracked -nE 'cfg(_attr)?!?\([^)]*(target_os|target_family|windows|unix)' -- '*.rs' ':!crates/emudome-platform/'
	rc_os=$?
	# shellcheck disable=SC2046 # one path per word; the exceptions have no spaces
	git grep --untracked -nE 'cfg(_attr)?!?\([^)]*(desktop|mobile)' -- '*.rs' ':!crates/emudome-platform/' \
		$(for f in $OS_CFG_EXCEPTIONS; do printf ':!%s\n' "$f"; done)
	rc_form=$?
	tables=$(git grep --untracked -E '^[[:space:]]*\[target\.' -- '*Cargo.toml' ':!crates/emudome-platform/')
	rc_tables=$?
	tables=$(printf '%s\n' "$tables" | grep -vxF -e "$OS_TARGET_TABLE_EXCEPTIONS" -e '')
	[ -n "$tables" ] && printf '%s\n' "$tables"
	for rc in $rc_os $rc_form $rc_tables; do
		[ "$rc" -gt 1 ] && return 2
	done
	if [ "$rc_os" -eq 0 ] || [ "$rc_form" -eq 0 ] || [ -n "$tables" ]; then
		return 0
	fi
	return 1
}
forbid 'os code outside emudome-platform' 'Move it into crates/emudome-platform (one module per OS), or behind one of its functions.' \
	os_code

# tauri, wgpu and librashader are pinned to exact versions (`=x.y.z`) and upgrade together, as one
# task with a native-video smoke test (app/src-tauri/Cargo.toml). Flags a declaration of one of
# them, at the start of a line, whose version does not start with `=`. Two different `=` pins of
# one crate cannot resolve, so the copies agree. Cannot see a renamed dependency
# (`x = { package = "tauri" }`) or a version on its own line; the spike (its own workspace) is left out.
forbid 'exact pins: tauri, wgpu, librashader' 'Pin it with "=x.y.z", the version in Cargo.lock.' \
	git grep --untracked -nE '^(tauri|wgpu|librashader) *= *(\{ *version *= *)?"[^=]' -- '*Cargo.toml' ':!crates/hw-render-spike/'

# "The UI never touches the core: it calls the Tauri commands through emu.ts". `invoke` or
# @tauri-apps/api/core anywhere in app/src but emu.ts. Cannot see `invoke` renamed on import
# from a module other than @tauri-apps/api/core.
forbid 'invoke outside emu.ts' 'Call the command through a typed function in app/src/emu.ts.' \
	git grep --untracked -nE '\binvoke\b|@tauri-apps/api/core' -- 'app/src/' ':!app/src/emu.ts'

# "Lucide icons, no emoji": emoji and decorative symbols (U+2600-27BF dingbats such as check
# marks, U+2B00-2BFF, U+1F000-1FAFF, the emoji selector U+FE0F) in the UI and in the Rust
# sources (error messages reach the UI). Cannot see an emoji built from code points at runtime.
forbid 'no emoji' 'Use a Lucide icon or plain text.' \
	git grep --untracked -nP '[\x{1F000}-\x{1FAFF}\x{2600}-\x{27BF}\x{2B00}-\x{2BFF}\x{FE0F}]' -- app/src app/src-tauri/src crates

# "User interface: never hardcoded": text nodes and static placeholder / title / aria-label /
# alt / label attributes in the .vue templates must go through t(). The rules, the exemptions
# (<kbd>, <code>, the product and key names) and what it cannot see are in the script.
# app/src/kit/ is left out, and from this gate only: the Kit page is development-only (main.ts
# mounts it behind import.meta.env.DEV, the production build drops it) and its labels name the
# primitives' states for whoever builds them, not for the user.
printf '\n=== visible text\n'
# shellcheck disable=SC2046 # one path per word; the repo has no spaces in .vue paths
node scripts/visible-text.mjs $(git ls-files --cached --others --exclude-standard -- '*.vue' ':!app/src/kit/') ||
	failed="$failed [visible text]"

# The design system's conventions (docs/frontend-conventions.md): tokens, primitives, variant
# constants, blocking in every file. The rules and what each cannot see are in the script. The
# self-test runs every rule on its fixture first, so a rule that stopped firing fails here too.
run 'design system: rules fire on their fixtures' node scripts/scan-conventions.mjs --self-test
run 'design system conventions' node scripts/scan-conventions.mjs

# "Never include Nintendo files (games, BIOS, firmware, keys)".
forbid 'no nintendo files' 'Remove it: the user adds games; the cores bring open-source BIOS replacements.' \
	nintendo_files

# "No secrets in the repo": no signing keystore (see keystore_files above).
forbid 'no keystores' 'Move it out of the repository and point EMUDOME_KEYSTORE at it.' \
	keystore_files

[ -n "$skipped" ] && printf '\nSKIPPED (not checked on this machine):%s\n' "$skipped"
if [ -n "$failed" ]; then
	printf '\nFAILED:%s\n' "$failed"
	exit 1
fi
if [ -n "$skipped" ]; then
	printf '\ngreen, except the skipped steps above\n'
else
	printf '\nall green\n'
fi
