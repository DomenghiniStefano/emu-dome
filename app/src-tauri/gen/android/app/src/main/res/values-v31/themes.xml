<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+ (Trello #101): the system splash (platform SplashScreen attributes, no
         compat library), graphite with EmuDome's amber mark as its icon (ic_splash, the mark in
         the 2/3 safe zone), not animated. The launcher's own foreground is the graphite mark cut
         by the edge on amber (2026-11-22), which would vanish on graphite.
         It lasts until the WebView's first frame, the page's own splash (index.html), which
         looks the same and shows the bar after 2 s. -->
    <style name="Theme.emudome" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/emudome_bg</item>
        <item name="android:windowSplashScreenBackground">@color/emudome_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_splash</item>
    </style>
</resources>
